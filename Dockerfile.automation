FROM python:3.11-alpine

# Install system dependencies + attack tools
RUN apk add --no-cache \
    curl \
    netcat-openbsd \
    bash \
    git \
    gcc \
    musl-dev \
    libffi-dev \
    openssl-dev \
    python3-dev

# Install Python packages
RUN pip install --no-cache-dir \
    python-owasp-zap-v2.4 \
    requests \
    urllib3

# Install SQLMap
RUN git clone --depth 1 https://github.com/sqlmapproject/sqlmap.git /opt/sqlmap && \
    ln -s /opt/sqlmap/sqlmap.py /usr/local/bin/sqlmap && \
    chmod +x /opt/sqlmap/sqlmap.py

# Install XSStrike
RUN git clone --depth 1 https://github.com/s0md3v/XSStrike.git /opt/xsstrike && \
    pip install --no-cache-dir -r /opt/xsstrike/requirements.txt && \
    echo '#!/bin/sh' > /usr/local/bin/xsstrike && \
    echo 'python3 /opt/xsstrike/xsstrike.py "$@"' >> /usr/local/bin/xsstrike && \
    chmod +x /usr/local/bin/xsstrike

# Install ffuf (cho dir fuzzing)
RUN curl -L https://github.com/ffuf/ffuf/releases/download/v2.1.0/ffuf_2.1.0_linux_amd64.tar.gz -o /tmp/ffuf.tar.gz && \
    tar -xzf /tmp/ffuf.tar.gz -C /usr/local/bin && \
    chmod +x /usr/local/bin/ffuf && \
    rm /tmp/ffuf.tar.gz

# Download wordlist for ffuf
RUN mkdir -p /usr/share/wordlists/dirb && \
    curl -L https://raw.githubusercontent.com/daviddias/node-dirbuster/master/lists/directory-list-2.3-small.txt \
    -o /usr/share/wordlists/dirb/common.txt

WORKDIR /opt

# Copy scripts
COPY phase1_capture.py /opt/phase1_capture.py
COPY phase2_replay.py /opt/phase2_replay.py
COPY run_pipeline.sh /opt/run_pipeline.sh

RUN chmod +x /opt/*.py /opt/run_pipeline.sh
RUN mkdir -p /output

CMD ["/opt/run_pipeline.sh"]
